# AI社員オフィス サーバー設定
# コピーして .env として使う: cp .env.example .env

# サーバーのポート番号
PORT=4000

# AI社員が実際に作業する対象リポジトリのパス（絶対パス推奨）
# 省略時はこのプロジェクト自身（ai_mgmt_company）が対象になる
TARGET_REPO=/Users/kiri/Develop/ai_mgmt_company

# 全社員共通で使う Anthropic API キー
# server/config/employees.json の apiKeyEnv で社員ごとに別の変数名を
# 指定すれば、その社員だけ別のキーを使わせることもできる（BYOK）
ANTHROPIC_API_KEY=sk-ant-...
