{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node server/hooks/hook-handler.mjs SessionStart" }] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node server/hooks/hook-handler.mjs PreToolUse" }] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node server/hooks/hook-handler.mjs PostToolUse" }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "node server/hooks/hook-handler.mjs Notification" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node server/hooks/hook-handler.mjs Stop" }] }
    ]
  }
}
